modules = ["bash", "python-base-3.13", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["flutter"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Satark preview"

[[workflows.workflow]]
name = "Satark preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "static"
build = ["bash", "scripts/build_web.sh"]
publicDir = "Satark_2/build/web"
